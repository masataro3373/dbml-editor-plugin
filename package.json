{
  "name": "dbml-editor-plugins",
  "version": "1.0.0",
  "description": "Official and custom plugins for dbml-editor-v2",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:all": "node scripts/build.mjs --all",
    "build:logicalname": "node scripts/build.mjs logicalname",
    "build:erstudio": "node scripts/build.mjs erstudio-excel",
    "build:oracle": "node scripts/build.mjs oracle-dialect",
    "build:postgres": "node scripts/build.mjs postgres-dialect",
    "build:mysql": "node scripts/build.mjs mysql-dialect",
    "build:mssql": "node scripts/build.mjs mssql-dialect",
    "build:snowflake": "node scripts/build.mjs snowflake-dialect",
    "build:bigquery": "node scripts/build.mjs bigquery-dialect",
    "build:redshift": "node scripts/build.mjs redshift-dialect",
    "build:spanner": "node scripts/build.mjs spanner-dialect",
    "build:databricks": "node scripts/build.mjs databricks-dialect",
    "deploy": "node scripts/deploy.mjs",
    "deploy:all": "node scripts/deploy.mjs --all",
    "test": "node --test tests/*.test.js"
  },
  "keywords": [
    "dbml",
    "plugin",
    "database"
  ],
  "author": "Official",
  "license": "MIT"
}

